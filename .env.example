# Токен Telegram-бота, к которому привязано это Mini App.
# Нужен, чтобы проверять подпись initData (см. app/lib/telegramAuth.ts).
TELEGRAM_BOT_TOKEN=

# API-ключ из дашборда @tribute (Настройки -> API). Используется, чтобы
# проверить подлинность входящих вебхуков (заголовок trbt-signature).
TRIBUTE_API_KEY=

# Публичная ссылка на тариф в Tribute (один тариф с двумя периодами — 1 и 3
# месяца, период пользователь выбирает уже на странице Tribute). Вида
# https://web.tribute.tg/p/{slug} или https://t.me/tribute/app?startapp={slug}
# — берётся в @tribute -> тариф -> «Ссылки». Показывается как кнопка оплаты.
NEXT_PUBLIC_TRIBUTE_LINK=

# Секретный ключ для входа автора без Telegram и без оплаты (см. app/lib/access.ts,
# app/api/access/route.ts). Придумайте длинную случайную строку и один раз откройте
# https://ваш-сайт.vercel.app/?key=ЭТА_СТРОКА в обычном браузере — доступ сохранится
# в этом браузере навсегда. Никому не передавайте эту ссылку и не публикуйте её.
OWNER_ACCESS_KEY=

# Постоянное хранилище выданных подписок (см. app/lib/access.ts). Подключается в
# Vercel Dashboard -> проект -> Storage -> Marketplace Database Providers -> Upstash
# (план Free бесплатный) -> Connect to Project. Vercel сам добавит эти переменные —
# руками их заполнять не нужно. Без них используется временное хранилище в памяти,
# подходящее только для локальной разработки: на Vercel оно теряет данные о том,
# кто оплатил, между вызовами и после каждого редеплоя.
KV_REST_API_URL=
KV_REST_API_TOKEN=
