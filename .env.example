# Токен Telegram-бота, к которому привязано это Mini App.
# Нужен, чтобы проверять подпись initData (см. app/lib/telegramAuth.ts).
TELEGRAM_BOT_TOKEN=

# API-ключ из дашборда @tribute (Настройки -> API). Используется, чтобы
# проверить подлинность входящих вебхуков (заголовок trbt-signature).
TRIBUTE_API_KEY=

# ID товаров в Tribute (видны после создания товара в дашборде).
# "1 месяц" -> 3900 руб, "3 месяца" -> 9900 руб.
TRIBUTE_PRODUCT_1M_ID=
TRIBUTE_PRODUCT_3M_ID=

# Публичные ссылки на оплату этих же товаров (вида
# https://web.tribute.tg/p/{ID} или https://telegram.me/tribute/app?startapp=p{ID}).
# Показываются как кнопки на экране подписки.
NEXT_PUBLIC_TRIBUTE_LINK_1M=
NEXT_PUBLIC_TRIBUTE_LINK_3M=
